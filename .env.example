GRIDPULSE_ENV=development
GRIDPULSE_DATABASE_URL=sqlite:///runtime/gridpulse.db
GRIDPULSE_MLFLOW_URI=sqlite:///runtime/mlflow.db
GRIDPULSE_DATA_SOURCE=synthetic
GRIDPULSE_MODEL_NAME=gridpulse-de-demand
GRIDPULSE_MODEL_ALIAS=champion
GRIDPULSE_MAX_MAPE=20
GRIDPULSE_MAX_MAE=10000
GRIDPULSE_BASELINE_RATIO=1.05
GRIDPULSE_DRIFT_THRESHOLD=0.25
GRIDPULSE_PERFORMANCE_RATIO=1.5
GRIDPULSE_MQTT_HOST=localhost
GRIDPULSE_MQTT_PORT=1883
# Real data only; never commit the token.
# ENTSOE_API_KEY=
# GRIDPULSE_S3_BUCKET=
# GRIDPULSE_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Compose requires these in your untracked .env:
# POSTGRES_PASSWORD=
# GRAFANA_PASSWORD=

